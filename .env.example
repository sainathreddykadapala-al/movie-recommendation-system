# CineMatch AI - Environment Configuration
# Copy this file to .env and configure your variables

# Flask Secret Key
SECRET_KEY=cinematch-ai-academic-secret-key-2026-prod

# The Movie Database (TMDB) API v3 Key
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# Database URI (Defaults to local SQLite)
DATABASE_PATH=database/movie_recommender.db

